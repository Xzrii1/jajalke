# Salin file ini menjadi .env.local, lalu isi nilainya.
# JANGAN commit .env.local ke repository.

# --- Supabase (server-side saja: seluruh akses DB lewat Server Actions,
# jadi TIDAK perlu prefix NEXT_PUBLIC_ — variabel tetap rahasia) ---
# Project URL (mis. https://abcd1234.supabase.co) dari
# Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=

# SERVICE ROLE key (WAJIB). Karena seluruh akses DB lewat server & RLS sudah
# AKTIF, kita pakai service role (rahasia, server-only) BUKAN anon key.
# Dapatkan dari Supabase Dashboard -> Project Settings -> API -> service_role.
# JANGAN pernah exposure key ini ke browser / klien.
SUPABASE_SERVICE_ROLE_KEY=

# (Opsional) anon/public key — tidak lagi dipakai app setelah migrasi RLS.
SUPABASE_ANON_KEY=

# --- Sesi aplikasi ---
# Secret untuk menandatangani JWT sesi. Buat dengan:
#   openssl rand -base64 32
# atau:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Seed akun admin (dipakai oleh `npm run seed:admin`) ---
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=ganti_dengan_password_yang_kuat