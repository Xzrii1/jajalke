# Salin file ini menjadi .env.local, lalu isi nilainya.
# JANGAN commit .env.local ke repository.

# --- Supabase ---
# Project URL (mis. https://abcd1234.supabase.co) & anon/public key dari
# Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (HANYA untuk script seed/lihat README). Jangan pernah
# expose key ini ke browser. Opsional jika RLS dinonaktifkan.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sesi aplikasi ---
# Secret untuk menandatangani JWT sesi. Buat dengan:
#   openssl rand -base64 32
# atau:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Seed akun admin (dipakai oleh `npm run seed:admin`) ---
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=ganti_dengan_password_yang_kuat